# Ubuntu / homelab SSH
REMOTE_HOST=192.168.1.10
REMOTE_PORT=22
REMOTE_USER=automation
REMOTE_KEY_FILENAME=C:/Users/you/.ssh/mcp_ed25519
REMOTE_PASSWORD=
REMOTE_SUDO_PASSWORD=
REMOTE_CONNECT_TIMEOUT=15

# Output compaction and bounds
MCP_RTK_COMPACT=1
MCP_RTK_THRESHOLD_CHARS=8000
MCP_MAX_OUTPUT_CHARS=24000
RTK_EXE=C:/Users/you/.local/bin/rtk.exe

# OpenTelemetry is disabled unless explicitly enabled.
MCP_OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Optional public URL for generated ComfyUI output links.
COMFY_PUBLIC_URL=http://comfy.example.lan
LAN_CIDR=192.168.1.0/24

# MikroTik
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=automation
MIKROTIK_PASSWORD=
MIKROTIK_USE_TLS=0

# Local UI
UI_HOST=127.0.0.1
UI_PORT=8765

# Home Assistant and optional SSH tunnel
HOMEASSISTANT_URL=http://192.168.1.20:8123
HOMEASSISTANT_TOKEN=
HOMEASSISTANT_TIMEOUT=15
HA_TUNNEL_LOCAL_HOST=127.0.0.1
HA_TUNNEL_LOCAL_PORT=18123
HA_TUNNEL_REMOTE_HOST=127.0.0.1
HA_TUNNEL_REMOTE_PORT=8123

# Observability
PROMETHEUS_URL=http://prometheus.example.lan
GRAFANA_URL=http://grafana.example.lan
UPTIME_KUMA_URL=http://status.example.lan
HOMEPAGE_URL=http://home.example.lan

# Steam Deck
STEAMDECK_HOST=192.168.1.30
STEAMDECK_PORT=22
STEAMDECK_USER=deck
STEAMDECK_PASSWORD=
STEAMDECK_KEY=
STEAMDECK_SUDO_PASSWORD=
STEAMDECK_CONNECT_TIMEOUT=15
STEAMDECK_LOCAL_DROPBOX=steamdeck_dropbox
STEAMDECK_EMULATION_ROOT=
